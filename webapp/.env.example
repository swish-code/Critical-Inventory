# Copy to .env and fill in. .env is gitignored - never commit it.

# ---------------------------------------------------------------------------
# Entra ID (Azure AD) app registration
# Used both as the Power BI service principal and for Microsoft sign-in.
# ---------------------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Register this exact URI on the app registration (platform: Web).
MS_REDIRECT_URI=http://localhost:7010/api/auth/microsoft/callback

# ---------------------------------------------------------------------------
# Power BI workspace + semantic model
# ---------------------------------------------------------------------------
PBI_WORKSPACE_ID=
PBI_DATASET_ID=

# ---------------------------------------------------------------------------
# Sign-in access (comma separated, case-insensitive)
# ---------------------------------------------------------------------------
# Administrators. Always allowed to sign in.
ADMIN_EMAILS=
# Everyone else who may sign in.
ALLOWED_EMAILS=

# TEMPORARY local email + password sign-in, until Microsoft sign-in works.
# On only when both are set and the password is 12+ characters. This account
# is an administrator. Delete both lines to turn it off.
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Hours a session lasts after sign-in.
SESSION_TTL_HOURS=12
# 1 drops the Secure flag from cookies. Local http development ONLY.
COOKIE_INSECURE=1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=7010
# Where the browser is sent after sign-in (the Vite dev server in development).
APP_ORIGIN=http://localhost:7011

# Seconds to cache each DAX result in memory (0 disables caching).
CACHE_TTL=120
